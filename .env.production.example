# Modelo de implantação. Não coloque segredos neste arquivo versionado.
# Mantenha as vendas fechadas durante a primeira publicação e homologação.
SALES_ENABLED=false
CHECKOUT_MODE=asaas
PRODUCT_PRICE_CENTS=4990

# Conta e chave exclusivas do ambiente de produção Asaas.
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_ACCESS_TOKEN=
ASAAS_WEBHOOK_TOKEN=

# Domínio oficial. Mantenha SITE_INDEXABLE=false até a aprovação do go-live.
APP_URL=https://pesdeseda.com.br
SITE_INDEXABLE=false
ASAAS_SUCCESS_URL=https://pesdeseda.com.br/pedido
ASAAS_CANCEL_URL=https://pesdeseda.com.br/pedido
ASAAS_EXPIRED_URL=https://pesdeseda.com.br/pedido
ASAAS_WEBHOOK_URL=https://pesdeseda.com.br/api/webhooks/asaas

# O arquivo deve ficar fora de public/. Em produção, use volume persistente
# privado em uma instância única até o adaptador de armazenamento ser criado.
PDF_STORAGE_KEY=/app/private/pes-de-seda.pdf
DATABASE_PATH=/app/data/pes-de-seda.sqlite
